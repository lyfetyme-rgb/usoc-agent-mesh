# Base URL of the operator web app / mobile universal links (no trailing slash).
APP_BASE_URL=https://app.example.com

# Optional custom app scheme used for the "one-tap" deep link in SMS.
# If unset, the HTTPS link above is used.
APP_DEEP_LINK_SCHEME=rok

# Twilio credentials for dispatchAlertNotification.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+15551234567

# Fallback number if a tenant has no on-duty technician configured (omit to skip).
# ALERT_FALLBACK_PHONE=+15557654321

# Feature tuning (defaults shown).
# TELEMETRY_MAX_BODY_BYTES=4096
# TELEMETRY_TTL_DAYS=30
# GATEWAY_OFFLINE_THRESHOLD_MS=180000
# HEARTBEAT_SCHEDULE=every 1 minute
# BREACH_ALERT_COOLDOWN_MS=300000

# H-LIFT signed assertion issuer (issueHliftAssertion).
# Must match the H-LIFT deployment's HLIFT_IDP_HMAC_SECRET / ISSUER / AUDIENCE.
# Generate with: openssl rand -base64 48
HLIFT_IDP_HMAC_SECRET=replace_with_shared_secret
HLIFT_IDP_ISSUER=https://idp.example.com
HLIFT_IDP_AUDIENCE=hlift
# Only set when the gateway and H-LIFT are on different subdomains of one domain.
# HLIFT_COOKIE_DOMAIN=example.com
HLIFT_ASSERTION_TTL_SECONDS=3600
# Comma-separated H-LIFT subjects this endpoint may assert (empty denies all).
HLIFT_ALLOWED_SUBJECTS=it.a.okoro,cmd.capt.patel,aud.d.wright,op.j.mendez,cust.k.rivera,cyber.s.lee
