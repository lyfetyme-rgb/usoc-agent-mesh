# TEMPLATE ONLY -- DO NOT APPLY WITH THE PLACEHOLDER VALUES AND DO NOT COMMIT
# REAL VALUES. Prefer an external secret operator (External Secrets Operator,
# Secrets Store CSI driver, cloud KMS) that materialises the Secret below.
#
# All token/secret material is mounted into pods as read-only FILES because
# USOC reads AGENT_SHARED_SECRET_FILE / AGENT_HEALTH_TOKEN_FILE / etc. The
# browser never receives any of these values; only the server-side proxy adds
# the Authorization header when it polls /health and /ready.
#
#   kubectl -n usoc-prod create secret generic usoc-mesh-secrets \
#     --from-file=agent-shared-secret=./secrets/agent_shared_secret.txt \
#     --from-file=health-token=./secrets/health_token.txt \
#     --from-file=admin-token=./secrets/admin_token.txt \
#     --from-literal=redis-url='rediss://:<password>@redis.internal:6379/0'
#
# Use REPLACE_ME only as a reminder; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
apiVersion: v1
kind: Secret
metadata:
  name: usoc-mesh-secrets
  namespace: usoc-prod
  labels:
    app.kubernetes.io/part-of: usoc-mesh
type: Opaque
stringData:
  agent-shared-secret: "REPLACE_ME_AT_LEAST_32_CHARS"
  health-token: "REPLACE_ME_AT_LEAST_32_CHARS"
  admin-token: "REPLACE_ME_DIFFERENT_FROM_HEALTH_TOKEN"
  redis-url: "rediss://REPLACE_ME_USER:REPLACE_ME_PASSWORD@redis.internal:6379/0"
