# Copy to .env.docker, then:
#   docker compose --env-file .env.docker up -d --build
#
# Do not put secrets in this file. Create the two secret files first:
#   ./secrets/agent_shared_secret.txt   (>= 32 chars, e.g. token_urlsafe(48))
#   ./secrets/health_token.txt          (>= 32 chars, e.g. token_urlsafe(32))
# SECURITY.md has PowerShell and Bash commands to generate them.

# Required: password for the internal Redis instance. Use URL-safe characters
# so it can be embedded in AGENT_REDIS_URL, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=replace-with-a-long-random-password

# Required: humans who may approve governed actions. Never include an agent id.
AGENT_APPROVERS=alice,bob

# Optional governance defaults.
AGENT_ALLOWED_TARGETS=sandbox/*,staging/*
AGENT_APPROVAL_TTL_S=86400
