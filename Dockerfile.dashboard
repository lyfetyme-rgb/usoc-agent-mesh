# syntax=docker/dockerfile:1.7

# Server-side dashboard proxy image. The browser never receives the health
# token: this process reads it from a mounted secret and adds the Authorization
# header itself. Reuses the mesh wheel so no extra runtime dependencies exist.

FROM python:3.12-slim AS builder
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1
WORKDIR /src
COPY pyproject.toml ./
COPY agents ./agents
COPY subsystems.yaml ./
RUN pip wheel --wheel-dir /wheels .

FROM python:3.12-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/tmp \
    USOC_DASHBOARD_PORT=8090

RUN groupadd --system --gid 10001 usoc \
    && useradd --system --uid 10001 --gid usoc \
        --home-dir /nonexistent --shell /usr/sbin/nologin usoc

WORKDIR /app
COPY --from=builder /wheels /wheels
RUN pip install --no-index --find-links=/wheels agent-mesh \
    && rm -rf /wheels
COPY dashboard /app/dashboard
COPY subsystems.yaml /app/subsystems.yaml

USER usoc
EXPOSE 8090
CMD ["python", "/app/dashboard/server.py"]
