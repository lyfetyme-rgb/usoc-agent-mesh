# Copy to .env and fill in. Every value has a safe local default.
# Secrets can also be supplied as files (recommended for containers):
#   AGENT_SHARED_SECRET_FILE=/run/secrets/agent_shared_secret
#   AGENT_HEALTH_TOKEN_FILE=/run/secrets/health_token

# --- Transport -------------------------------------------------------------
# memory = single process, zero infra (default, used by the demo)
# redis  = durable streams + consumer groups (use for real deployments)
AGENT_BUS=memory
AGENT_REDIS_URL=redis://localhost:6379/0
AGENT_REDIS_SOCKET_TIMEOUT_S=5
AGENT_CONSUMER_GROUP=mesh

# --- Security --------------------------------------------------------------
# Message authentication is on by default. With AGENT_BUS=redis an explicit
# secret is required; the process fails closed without one.
AGENT_MESSAGE_AUTH=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AGENT_SHARED_SECRET=
AGENT_SHARED_SECRET_FILE=
# Optional replay window; 0 disables it (safe with at-least-once delivery).
AGENT_MAX_MESSAGE_AGE_S=0

# Humans who may approve governed actions. Never include an agent id.
AGENT_APPROVERS=alice,bob
# Production: fail closed when the allowlist is empty.
AGENT_REQUIRE_APPROVER_ALLOWLIST=false
# Pending approvals expire after this many seconds.
AGENT_APPROVAL_TTL_S=86400

# --- Production trust (AGENT_STRICT_PROD=1) ---------------------------------
# Strict mode disables every dev fallback. `python -m agents doctor` fails
# closed unless all of the following are present. Files are written by your
# secret manager (Secrets Manager/Vault/KMS sidecar); no cloud SDK is required.
AGENT_STRICT_PROD=0
# Cluster-level approval/evidence signing (separate from the bus keys below).
# AGENT_SIGNING_MODE=ed25519
# AGENT_ED25519_PUBLIC_KEYS_FILE=/run/secrets/ed25519_public_keys.json
# AGENT_ED25519_PRIVATE_KEY_FILE=/run/secrets/ed25519_private.pem
# AGENT_KMS_SIGN_URL=http://127.0.0.1:8081/sign
# AGENT_KMS_SIGN_TOKEN_FILE=/run/secrets/kms_token

# Per-coordinator bus identity. Public bundle (mounted on every node):
#   {"seraphim": {"seraphim-1": "<hex public key>"},
#    "hitl":     {"hitl-1": "<hex public key>"}}
# Only the node acting as an identity mounts that identity's private key.
# These paths are examples — uncomment them when switching strict mode on.
# AGENT_BUS_PUBLIC_KEYS_FILE=/run/secrets/bus_public_keys.json
# AGENT_BUS_SIGNING_AGENT=seraphim
# AGENT_BUS_SIGNING_KID=seraphim-1
# AGENT_BUS_SIGNING_KEY_FILE=/run/secrets/bus_seraphim.pem
# Alternative to a private key file: a KMS/sidecar signing endpoint.
# AGENT_BUS_KMS_SIGN_URL=http://127.0.0.1:8081/sign
# AGENT_BUS_KMS_SIGN_TOKEN_FILE=/run/secrets/kms_token

# Signed approver registry: approver_id -> {role, public_key, max_tier}.
# Generate the keypair with `agents keygen`, the registry with JSON, and sign
# it with `agents sign-approvers --registry-file ... --key-file ...`.
# AGENT_APPROVER_REGISTRY_FILE=/run/secrets/approvers.json
# AGENT_APPROVER_REGISTRY_SIGNATURE_FILE=/run/secrets/approvers.json.sig
# AGENT_APPROVER_REGISTRY_PUBLIC_KEY_FILE=/run/secrets/approvers_public.hex
# Human credentials: detached Ed25519 signatures, OIDC id_tokens, or both.
AGENT_APPROVAL_CREDENTIAL_MODE=either
AGENT_APPROVAL_REQUIRE_CREDENTIAL=0
# AGENT_APPROVAL_OIDC_ISSUER=https://example.okta.com/oauth2/default
# AGENT_APPROVAL_OIDC_AUDIENCE=usoc-mesh
# AGENT_APPROVAL_OIDC_JWKS_URL=https://example.okta.com/oauth2/default/v1/keys
# AGENT_APPROVAL_OIDC_SUB_CLAIM=sub
# AGENT_APPROVAL_OIDC_ROLE_CLAIM=roles
# id_token claim carrying the per-approval binding digest (standard nonce by default)
# AGENT_APPROVAL_OIDC_BINDING_CLAIM=nonce

# Destructive workspace tool is disabled unless explicitly enabled.
AGENT_ALLOW_WORKSPACE_DELETE=false

# --- Service ---------------------------------------------------------------
# Read-only /health and /ready. No work is accepted over HTTP.
AGENT_HEALTH_HOST=127.0.0.1
AGENT_HEALTH_PORT=8080
AGENT_HEALTH_TOKEN=
AGENT_HEALTH_TOKEN_FILE=
# How often a Redis worker reclaims messages from a crashed peer.
AGENT_RECLAIM_INTERVAL_S=30

# --- Model -----------------------------------------------------------------
# Any OpenAI-compatible endpoint: OpenAI, OpenRouter, vLLM, Ollama, LiteLLM...
# Leave base_url empty to run the deterministic offline model.
AGENT_LLM_BASE_URL=
AGENT_LLM_API_KEY=
AGENT_MODEL=gpt-4.1-mini
AGENT_MODEL_FAST=gpt-4.1-nano
# Remote endpoints must use https:// so the API key is not sent in clear text.
# Set true only for a trusted local network (e.g. host.docker.internal:11434).
AGENT_ALLOW_INSECURE_LLM=false

# --- Governance ------------------------------------------------------------
AGENT_ALLOWED_TARGETS=sandbox/*,staging/*
AGENT_MISSION_ID=
# Shadow deployment: run policy/HITL/evidence against real inputs with NO
# execution, NO external writes and an isolated workspace/approval store.
AGENT_SHADOW_MODE=false

# --- Industry Starter Profiles ---------------------------------------------
# A profile only filters the capability-card role VIEW. All nine coordinators
# keep running with their ACLs, tiers and signed cards. Profile control defaults
# below are applied only when the matching AGENT_* variable is NOT set here.
#   core | finops_banking | clinical_healthcare | full_usoc (default)
AGENT_ROLE_PROFILE=full_usoc

# FinOps & Banking pack: hard per-transaction ceiling and approval quorum.
# An explicit setting overrides the pack default (5000.00 / 2). The ceiling is
# rechecked at execution time; an approval can never raise it.
AGENT_MAX_TRANSACTION_AMOUNT=
AGENT_TRANSACTION_CURRENCY=USD
AGENT_APPROVAL_QUORUM=1
# Number of distinct verified humans required for a HITL quorum (1-9).

# Clinical & Healthcare pack: PII/PHI detection on every connector (raises
# classification to RESTRICTED and sets monotone taint) and signed egress guard
# on external publication. Explicit settings override the pack defaults.
AGENT_PHI_DETECTION_ENABLED=false
AGENT_BLOCK_TAINTED_EGRESS=false

# OEKP/BENGAL compliance exports. Formats: jsonl, oekp, bengal, oekp_bengal.
# `agents export --format ...` overrides this for a single run.
AGENT_EVIDENCE_EXPORT_FORMATS=jsonl

# --- Fragmentation: read-only connectors + correlation ---------------------
# YAML describing incumbent systems. Connectors never write. If the file is
# absent, the fragmentation layer is disabled and SHELL reports it.
AGENT_CONNECTORS_FILE=connectors.yaml
AGENT_CONNECTOR_TIMEOUT_S=15
AGENT_CONNECTOR_MAX_RECORDS=5000
AGENT_CONNECTOR_MAX_BYTES=2000000
# Comma-separated host allowlist for http_json connectors. Empty = fail closed.
AGENT_CONNECTOR_ALLOWED_HOSTS=
# Plain HTTP is only allowed for loopback hosts (local test APIs).
AGENT_CONNECTOR_ALLOW_HTTP_LOOPBACK=true
# Cross-source correlation: one entity, one time window, at least this many
# distinct source types, at least this risk score.
AGENT_CORRELATION_WINDOW_S=900
AGENT_CORRELATION_MIN_SOURCES=2
AGENT_CORRELATION_MIN_SCORE=40

# --- Limits ----------------------------------------------------------------
AGENT_MAX_CONCURRENCY=4
AGENT_TASK_TIMEOUT_S=120
AGENT_MAX_ATTEMPTS=3
# Bounded exponential backoff between requeues of a retryable error.
AGENT_RETRY_BACKOFF_BASE_S=0.25
AGENT_RETRY_BACKOFF_MAX_S=2.0
AGENT_MAX_HOPS=8
AGENT_LOG_LEVEL=INFO
AGENT_LOG_JSON=false

# --- Files -----------------------------------------------------------------
AGENT_SUBSYSTEMS_FILE=subsystems.yaml
AGENT_WORKSPACE=workspace
