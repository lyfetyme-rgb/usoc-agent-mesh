# Copy to .env and fill in. Every value has a safe local default.
# Secrets can also be supplied as files (recommended for containers):
#   AGENT_SHARED_SECRET_FILE=/run/secrets/agent_shared_secret
#   AGENT_HEALTH_TOKEN_FILE=/run/secrets/health_token

# --- Transport -------------------------------------------------------------
# memory = single process, zero infra (default, used by the demo)
# redis  = durable streams + consumer groups (use for real deployments)
AGENT_BUS=memory
AGENT_REDIS_URL=redis://localhost:6379/0
AGENT_REDIS_SOCKET_TIMEOUT_S=5
AGENT_CONSUMER_GROUP=mesh

# --- Security --------------------------------------------------------------
# Message authentication is on by default. With AGENT_BUS=redis an explicit
# secret is required; the process fails closed without one.
AGENT_MESSAGE_AUTH=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AGENT_SHARED_SECRET=
AGENT_SHARED_SECRET_FILE=
# Optional replay window; 0 disables it (safe with at-least-once delivery).
AGENT_MAX_MESSAGE_AGE_S=0

# Humans who may approve governed actions. Never include an agent id.
AGENT_APPROVERS=alice,bob
# Production: fail closed when the allowlist is empty.
AGENT_REQUIRE_APPROVER_ALLOWLIST=false
# Pending approvals expire after this many seconds.
AGENT_APPROVAL_TTL_S=86400

# Destructive workspace tool is disabled unless explicitly enabled.
AGENT_ALLOW_WORKSPACE_DELETE=false

# --- Service ---------------------------------------------------------------
# Read-only /health and /ready. No work is accepted over HTTP.
AGENT_HEALTH_HOST=127.0.0.1
AGENT_HEALTH_PORT=8080
AGENT_HEALTH_TOKEN=
AGENT_HEALTH_TOKEN_FILE=
# How often a Redis worker reclaims messages from a crashed peer.
AGENT_RECLAIM_INTERVAL_S=30

# --- Model -----------------------------------------------------------------
# Any OpenAI-compatible endpoint: OpenAI, OpenRouter, vLLM, Ollama, LiteLLM...
# Leave base_url empty to run the deterministic offline model.
AGENT_LLM_BASE_URL=
AGENT_LLM_API_KEY=
AGENT_MODEL=gpt-4.1-mini
AGENT_MODEL_FAST=gpt-4.1-nano
# Remote endpoints must use https:// so the API key is not sent in clear text.
# Set true only for a trusted local network (e.g. host.docker.internal:11434).
AGENT_ALLOW_INSECURE_LLM=false

# --- Governance ------------------------------------------------------------
AGENT_ALLOWED_TARGETS=sandbox/*,staging/*
AGENT_MISSION_ID=

# --- Fragmentation: read-only connectors + correlation ---------------------
# YAML describing incumbent systems. Connectors never write. If the file is
# absent, the fragmentation layer is disabled and SHELL reports it.
AGENT_CONNECTORS_FILE=connectors.yaml
AGENT_CONNECTOR_TIMEOUT_S=15
AGENT_CONNECTOR_MAX_RECORDS=5000
AGENT_CONNECTOR_MAX_BYTES=2000000
# Comma-separated host allowlist for http_json connectors. Empty = fail closed.
AGENT_CONNECTOR_ALLOWED_HOSTS=
# Plain HTTP is only allowed for loopback hosts (local test APIs).
AGENT_CONNECTOR_ALLOW_HTTP_LOOPBACK=true
# Cross-source correlation: one entity, one time window, at least this many
# distinct source types, at least this risk score.
AGENT_CORRELATION_WINDOW_S=900
AGENT_CORRELATION_MIN_SOURCES=2
AGENT_CORRELATION_MIN_SCORE=40

# --- Limits ----------------------------------------------------------------
AGENT_MAX_CONCURRENCY=4
AGENT_TASK_TIMEOUT_S=120
AGENT_MAX_ATTEMPTS=3
AGENT_MAX_HOPS=8
AGENT_LOG_LEVEL=INFO
AGENT_LOG_JSON=false

# --- Files -----------------------------------------------------------------
AGENT_SUBSYSTEMS_FILE=subsystems.yaml
AGENT_WORKSPACE=workspace
